NODE_ENV=staging
PORT=3000

# Secretos obligatorios para el entorno de staging.
ADMIN_SECRET=generate_a_long_random_value
JWT_SECRET=generate_a_second_long_random_value
QR_SECRET=generate_a_third_independent_random_value
JWT_EXP=6h
QR_TTL_MS=60000
QR_NONCE_CLEANUP_INTERVAL_MS=300000

ALLOWED_ORIGINS=https://staging.control-seguridad.example
FIREBASE_PROJECT_ID=control-seguridad-staging
FIREBASE_DATABASE_URL=https://control-seguridad-staging-default-rtdb.firebaseio.com/
FIREBASE_WEB_API_KEY=replace-with-staging-web-api-key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.staging.json

BACKUP_OUTPUT_DIR=./backups
RETENTION_DAYS=90
