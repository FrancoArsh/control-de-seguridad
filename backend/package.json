{
  "name": "access-control-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/unit/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs",
    "emulator:test": "firebase emulators:exec --only database --project control-de-seguridad-test \"npm run test:integration\"",
    "emulator:ops": "firebase emulators:exec --only database --project control-de-seguridad-test \"node --test test/operations.test.mjs\"",
    "emulator:recovery": "firebase emulators:exec --only database --project control-de-seguridad-test \"node --test test/recovery.test.mjs\"",
    "load:test": "node scripts/load-test.mjs",
    "backup:staging": "node scripts/backup-rtdb.mjs",
    "retention:preview": "node scripts/retention-rtdb.mjs",
    "retention:apply": "node scripts/retention-rtdb.mjs --apply=true",
    "restore:preview": "node scripts/restore-rtdb.mjs",
    "restore:apply": "node scripts/restore-rtdb.mjs --apply=true",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "credentials:recovery": "node scripts/credential-recovery.mjs"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
