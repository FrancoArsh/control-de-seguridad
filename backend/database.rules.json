{
  "rules": {
    ".read": false,
    ".write": false,
    "accessHistory": {
      ".indexOn": ["timestamp", "studentUid", "guardId", "shiftId"]
    },
    "adminAuditLog": {
      ".indexOn": ["timestamp", "actorId"]
    },
    "securityEvents": {
      ".indexOn": ["timestamp", "type", "outcome"]
    },
    "guardShifts": {
      ".indexOn": ["guardId", "startTimestamp", "endTimestamp"]
    },
    "guardAuthorizations": {
      ".indexOn": ["guardId", "timestamp"]
    },
    "dynamicQrNonces": {
      ".indexOn": ["expiresAt"]
    }
  }
}
