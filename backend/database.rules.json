{
  "rules": {
    ".read": false,
    ".write": false,
    "accessHistory": {
      ".indexOn": ["timestamp", "id", "studentUid", "guardId", "shiftId"]
    },
    "accessState": {
      ".indexOn": ["_pendingAccess/status"]
    },
    "adminAuditLog": {
      ".indexOn": ["timestamp", "actorId", "entityId"]
    },
    "securityEvents": {
      ".indexOn": ["timestamp", "type", "outcome"]
    },
    "guardShifts": {
      ".indexOn": ["guardId", "startTimestamp", "endTimestamp"]
    },
    "guardAuthorizations": {
      ".indexOn": ["guardId", "timestamp"]
    },
    "dynamicQrNonces": {
      ".indexOn": ["expiresAt"]
    },
    "portalSessions": {
      ".indexOn": ["expiresAt"]
    },
    "accessTokens": {
      ".indexOn": ["token"]
    }
  }
}
