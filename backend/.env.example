NODE_ENV=development
PORT=3000

# Use valores largos, aleatorios y diferentes por ambiente.
ADMIN_SECRET=change_me_with_a_long_random_value
JWT_SECRET=change_me_with_another_long_random_value
JWT_EXP=6h
# Clave independiente para firmar QR dinámicos. No reutilizar JWT_SECRET en producción.
QR_SECRET=change_me_with_a_third_long_random_value
QR_TTL_MS=60000
QR_NONCE_CLEANUP_INTERVAL_MS=300000

# Separar origenes por coma en produccion.
ALLOWED_ORIGINS=http://localhost:3000

FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/

# Solo para pruebas de integración con Firebase Emulator.
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Use una de estas opciones en despliegue. No versionar credenciales reales.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# SERVICE_ACCOUNT_JSON_BASE64=

GUARD_LOGIN_MAX_ATTEMPTS=5
GUARD_LOGIN_LOCK_MS=300000
